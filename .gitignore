# Godot 4+ specific ignores
.godot/
/android/

# The AdMob iOS SDK binaries (~29 MB) are committed so the CI iOS build has no
# runtime download dependency. tools/fetch_assets.* can still restore them.

# Build output
/build/

# Local screenshots (tools/screenshot.gd, tools/playthrough.gd)
/shot*.png
/shot*.png.import
/play_*.png
/play_*.png.import

# Store screenshot intermediates (regenerate: tools/screenshot.gd)
/store/raw/
