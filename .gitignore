# Godot 4+ specific ignores
.godot/
/android/

# Heavy vendored native SDK binaries — restored by tools/fetch_assets.* / CI.
# The AdMob plugin's GDScript (addons/AdmobPlugin/*.gd) IS committed; only the
# large Google binaries are fetched.
/ios/framework/
/ios/plugins/*.a

# Build output
/build/

# Local screenshots (tools/screenshot.gd, tools/playthrough.gd)
/shot*.png
/shot*.png.import
/play_*.png
/play_*.png.import

# Store screenshot intermediates (regenerate: tools/screenshot.gd)
/store/raw/
